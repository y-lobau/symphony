<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>ai.openclaw.symphony.plyn</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/opt/erlang@28/bin/escript</string>
		<string>/Volumes/ext/git/plyn-symphony/elixir/bin/symphony</string>
		<string>--i-understand-that-this-will-be-running-without-the-usual-guardrails</string>
		<string>--logs-root</string>
		<string>/Volumes/ext/git/plyn-symphony/var/logs</string>
		<string>--port</string>
		<string>4097</string>
		<string>/Volumes/ext/git/plyn-symphony/WORKFLOW.plyn.md</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>GH_CONFIG_DIR</key>
		<string>/Users/yanlobau/Library/Application Support/plyn-symphony/gh-config</string>
		<key>PATH</key>
		<string>/opt/homebrew/opt/erlang@28/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/yanlobau/Library/Logs/plyn-symphony/stderr.log</string>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>WorkingDirectory</key>
	<string>/Users/yanlobau/Library/Application Support/plyn-symphony</string>
</dict>
</plist>
